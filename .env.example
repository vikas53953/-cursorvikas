# Required for voice: OpenAI API key with Realtime access.
OPENAI_API_KEY=your_openai_api_key_here

# Optional: Exa API key for web search.
EXA_API_KEY=your_exa_api_key_here

# Network source: "auto" (default), "live", or "sim".
#   auto = use Catalyst Center if reachable, otherwise the built-in simulator.
NETJARVIS_SOURCE=auto

# Catalyst Center (defaults are the public Cisco DevNet Always-On sandbox,
# a real 4-switch Catalyst 9000v network - no VPN or account needed).
# Point these at your own Catalyst Center to run against your network.
#CATC_BASE_URL=https://sandboxdnac.cisco.com
#CATC_USERNAME=devnetuser
#CATC_PASSWORD=Cisco123!

# Optional: SMTP for send_email (instead of copy-paste only).
#SMTP_HOST=smtp.example.com
#SMTP_PORT=587
#SMTP_USER=noc@example.com
#SMTP_PASS=your_smtp_password
#SMTP_FROM=NetJarvis <noc@example.com>

# Optional: multi-source adapters.
#PROMETHEUS_URL=http://localhost:9090
#SNMP_HOST=192.168.1.1
#SNMP_COMMUNITY=public

# Background services (defaults: enabled).
#SHIFT_BRIEFING_ENABLED=true
#SHIFT_BRIEFING_INTERVAL_MINUTES=480
#ALERT_WATCH_ENABLED=true
#ALERT_WATCH_INTERVAL_MINUTES=1

# SSH executor (Phase 1 validation target: Cisco always-on IOS-XE sandbox).
# Launch it from devnetsandbox.cisco.com to get current credentials.
#SSH_SANDBOX_HOST=sandbox-iosxe-latest-1.cisco.com
#SSH_SANDBOX_PORT=22
#SSH_SANDBOX_USER=your_dynamic_user
#SSH_SANDBOX_PASS=your_dynamic_pass
# Optional jump host / bastion in front of devices:
#SSH_JUMP_HOST=
#SSH_JUMP_USER=
#SSH_JUMP_PASS=
