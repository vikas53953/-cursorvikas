{
  "name": "netjarvis",
  "version": "1.0.0",
  "description": "NetJarvis is a local Electron desktop AI copilot for network operations, powered by OpenAI Realtime voice.",
  "main": "electron/main.cjs",
  "scripts": {
    "dev": "concurrently -k \"vite --host 127.0.0.1\" \"wait-on tcp:5173 && VITE_DEV_SERVER_URL=http://127.0.0.1:5173 electron .\"",
    "start": "electron .",
    "web": "node server/web.cjs",
    "test:behavior": "node scripts/behavior-cycle.cjs",
    "build": "tsc --noEmit && vite build",
    "typecheck": "tsc --noEmit"
  },
  "keywords": ["electron", "openai", "realtime", "voice", "network-operations", "noc", "ai-copilot"],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "dotenv": "^17.4.2",
    "lucide-react": "^1.22.0",
    "mermaid": "^11.16.0",
    "nodemailer": "^7.0.5",
    "react": "^19.2.7",
    "react-dom": "^19.2.7"
  },
  "devDependencies": {
    "@types/react": "^19.2.17",
    "@types/react-dom": "^19.2.3",
    "@vitejs/plugin-react": "^6.0.3",
    "concurrently": "^10.0.3",
    "electron": "^42.5.1",
    "typescript": "^6.0.3",
    "vite": "^8.1.0",
    "wait-on": "^9.0.10"
  }
}
